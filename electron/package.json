{
  "name": "maxedgevideoplayer",
  "version": "1.0.0",
  "description": "Electron video player with multi-engine real-time TTS translation (ElevenLabs, Google Cloud TTS)",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.0",
    "axios": "^1.6.0",
    "ffmpeg-static": "^5.1.0",
    "franc": "^6.2.0",
    "keytar": "^7.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^25.3.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.maxedgevideoplayer.app",
    "files": [
      "dist/**",
      "main.js",
      "preload.js"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "optionalDependencies": {
    "sherpa-onnx": "^1.13.8"
  }
}
